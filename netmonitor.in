name="netmonitor daemon"
description="Network monitor and outage logger"
command="@PWD@/run.sh"
command_args=""
command_background=true
command_user="@USER@:@GROUP@"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
  need net
  use dns logger
}

